{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "dist-lib",
    "coverage",
    "test-results",
    "playwright-report",
    "package-lock.json",
    "CHANGELOG.md",
    "docs/*.png",
    ".cortexkit",
    ".opencode",
    ".playwright-mcp"
  ]
}
